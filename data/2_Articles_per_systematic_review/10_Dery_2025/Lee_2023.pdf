                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Values for Journal Article Version are one of the following:&#xA;AO = Authorâ€™s Original&#xA;SMUR = Submitted Manuscript Under Review&#xA;AM = Accepted Manuscript&#xA;P = Proof&#xA;VoR = Version of Record&#xA;CVoR = Corrected Version of Record&#xA;EVoR = Enhanced Version of Record</pdfaProperty:description>
                           <pdfaProperty:name>journal_article_version</pdfaProperty:name>
                           <pdfaProperty:valueType>Closed Choice of Text</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
